# Readarr Docker Configuration

# Port Configuration
READARR_PORT=8787

# Volume Paths
BOOKS_PATH=./books
DOWNLOADS_PATH=./downloads

# User/Group IDs (for file permissions)
PUID=1000
PGID=1000

# Timezone
TZ=UTC

# Readarr Instance Configuration
READARR__INSTANCE_NAME=Readarr
READARR__BRANCH=develop
READARR__LOG_LEVEL=info

# PostgreSQL Configuration (optional - leave commented for SQLite)
# POSTGRES_USER=readarr
# POSTGRES_PASSWORD=your_secure_password_here
# POSTGRES_MAINDB=readarr-main

# Application URLs
READARR__URL_BASE=/

# Analytics (set to False to disable)
READARR__ANALYTICS_ENABLED=True

# Authentication
# READARR__AUTH_METHOD=None
# READARR__AUTH_REQUIRED=DisabledForLocalAddresses
# READARR__USERNAME=admin
# READARR__PASSWORD=admin

# API Key (auto-generated on first run if not set)
# READARR__API_KEY=

# Update Settings
READARR__UPDATE_MECHANISM=Docker

# SSL Configuration (if using reverse proxy)
# READARR__SSL_CERT_PATH=
# READARR__SSL_CERT_PASSWORD=

# Backup Settings
READARR__BACKUP_FOLDER=/config/Backups
READARR__BACKUP_INTERVAL=7
READARR__BACKUP_RETENTION=28

# Log Settings
READARR__LOG_FILE=/config/logs/readarr.txt
# READARR__LOG_SQL=False

# Proxy Settings
# READARR__PROXY_ENABLED=False
# READARR__PROXY_TYPE=Http
# READARR__PROXY_HOSTNAME=
# READARR__PROXY_PORT=
# READARR__PROXY_USERNAME=
# READARR__PROXY_PASSWORD=
# READARR__PROXY_BYPASS_LOCAL_ADDRESSES=True
